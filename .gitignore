# ---- 构建产物 ----
.build/
.swiftpm/
dist/
*.zip
*.dSYM/

# ---- 测试数据 ----
# 约 254MB 的生成文件，用脚本按需重建：
#   python3 tools/gen_test_files.py    # 大文件基准（1MB / 50MB / 200MB）
#   python3 tools/gen_samples.py 40    # 小样例（多标签 / 三格式高亮）
tools/testdata/

# ---- 测试源码 ----
# 测试用例只在本地跑（swift run CoreTests），不随仓库分发
Tests/

# ---- 本地工作记录 ----
# 含本机路径、调试过程与临时结论，只留在本地，不随仓库分发
.workbuddy/

# ---- Xcode ----
# 用 Xcode 打开 Package.swift 时会生成这些，不该进仓库
xcuserdata/
*.xcuserstate
DerivedData/

# ---- macOS ----
.DS_Store
